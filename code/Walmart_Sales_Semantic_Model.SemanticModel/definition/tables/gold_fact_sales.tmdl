table gold_fact_sales
	lineageTag: d5c89358-46ce-4bfa-89ba-e738355ffbb0
	sourceLineageTag: [dbo].[gold_fact_sales]

	measure Total_sales = SUM(gold_fact_sales[line_amount])
		lineageTag: 2a3c1173-2de1-4b1d-9258-5e885a3fe26e

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Order = COUNT(gold_fact_sales[order_id])
		formatString: 0
		lineageTag: ec7e83f5-e91d-46e1-91d5-d8980ebf25f2

		changedProperty = Name

		changedProperty = IsHidden

	measure Total_Quantity =
			
			SUM(gold_fact_sales[quantity])
		formatString: 0
		lineageTag: f20763ba-eaa9-4960-9ee5-0e2bd534ee57

		changedProperty = Name

		changedProperty = IsHidden

	measure Average_Order_value = ```
			DIVIDE([Total_sales],[Total_Order]) 
			```
		lineageTag: c6bcddd6-d2d4-45a2-b088-a11d43196fe8

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Historical Sales' =
			
			CALCULATE(
			    [Total_Sales],
			    gold_fact_sales[data_source] = "Historical"
			)
		lineageTag: bcd781dd-a0aa-4206-977b-32ec2b0c64c2

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Real-Time Sales' =
			
			CALCULATE(
			    [Total_Sales],
			    gold_fact_sales[data_source] = "Real-Time"
			)
		lineageTag: 5ac6ab37-1995-45d7-ba19-6b9810ab2ee5

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Difference' =
			
			[Real-Time Sales] - [Historical Sales]
		lineageTag: 77cb5154-d874-4be5-8ca7-727c4acb39d3

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Growth %' =
			
			DIVIDE(
			    [Sales Difference],
			    [Historical Sales]
			)
		lineageTag: 3a79d0ca-056d-4217-a130-36212bf50e5c

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

